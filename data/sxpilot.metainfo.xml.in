<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>SxPilot</name>
  <summary>Manage SSH and SFTP connections</summary>
  <description>
    <p>
      SxPilot organizes your remote servers into groups and opens SSH and
      SFTP sessions in tabs, so several connections can stay open at once.
    </p>
    <ul>
      <li>Group connections by project or environment</li>
      <li>Open SSH or SFTP sessions in tabs</li>
      <li>Password, key file or SSH agent authentication</li>
      <li>Passwords stored securely in the system keyring</li>
    </ul>
  </description>
  <developer id="es.agustingarcia">
    <name>Agustín García</name>
  </developer>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-02"/>
  </releases>
</component>
