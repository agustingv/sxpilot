#: data/sxpilot.desktop.in:2
msgid "SxPilot"
msgstr "SxPilot"

#: data/sxpilot.desktop.in:3
msgid "SSH Connection Manager"
msgstr "Gestor de conexiones SSH"

#: data/sxpilot.desktop.in:4
msgid "Manage and open SSH and SFTP connections in tabs"
msgstr "Gestione y abra conexiones SSH y SFTP en pestañas"

#: data/sxpilot.desktop.in:10
msgid "ssh;sftp;terminal;remote;server;"
msgstr "ssh;sftp;terminal;remoto;servidor;remote;server;"

#: data/sxpilot.metainfo.xml.in:7
msgid "Manage SSH and SFTP connections"
msgstr "Gestione conexiones SSH y SFTP"

#: data/sxpilot.metainfo.xml.in:9
msgid "SxPilot organizes your remote servers into groups and opens SSH and SFTP sessions in tabs, so several connections can stay open at once."
msgstr "SxPilot organiza sus servidores remotos en grupos y abre sesiones SSH y SFTP en pestañas, para que pueda mantener varias conexiones abiertas a la vez."

#: data/sxpilot.metainfo.xml.in:14
msgid "Group connections by project or environment"
msgstr "Agrupe las conexiones por proyecto o entorno"

#: data/sxpilot.metainfo.xml.in:15
msgid "Open SSH or SFTP sessions in tabs"
msgstr "Abra sesiones SSH o SFTP en pestañas"

#: data/sxpilot.metainfo.xml.in:16
msgid "Password, key file or SSH agent authentication"
msgstr "Autenticación con contraseña, archivo de clave o agente SSH"

#: data/sxpilot.metainfo.xml.in:17
msgid "Passwords stored securely in the system keyring"
msgstr "Contraseñas guardadas de forma segura en el depósito de claves del sistema"

